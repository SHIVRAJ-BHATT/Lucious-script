  "strings/tips/aim_punches": {
   "v": "You can \"aim\" your punches by spinning left or right. This is useful for knocking bad guys off edges or scoring in hockey.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/auto_kick_idle": {
   "v": "If you've got lots of players coming and going, turn on 'auto-kick-idle-players' under settings in case anyone forgets to leave the game.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/cant_reach_ledge": "No, you can't get up on the ledge. You have to throw bombs.",
  "strings/tips/characters_identical": {
   "v": "Despite their looks, all characters' abilities are identical, so just pick whichever one you most closely resemble.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/cook_off_bombs": "Try 'cooking off' bombs for a second or two before throwing them.",
  "strings/tips/create_profiles": {
   "v": "Create player profiles for yourself and your friends with your preferred names and appearances instead of using random ones.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/ctf_own_flag": {
   "v": "In Capture-the-Flag, your own flag must be at your base to score. If the other team is about to score, stealing their flag can be a good way to stop them.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/curse_boxes": {
   "v": "Curse boxes turn you into a ticking time bomb. The only cure is to quickly grab a health-pack.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/curse_health_powerup": {
   "v": "If you pick up a curse, your only hope for survival is to find a health powerup in the next few seconds.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/custom_soundtrack": {
   "v": "Tired of the soundtrack? Replace it with your own! See Settings->Audio->Soundtrack",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/dont_always_run": "Don't run all the time. Really. You will fall off cliffs.",
  "strings/tips/dont_overspin": "Don't spin for too long; you'll become dizzy and fall.",
  "strings/tips/endless_high_score": {
   "v": "This level never ends, but a high score here will earn you eternal respect throughout the world.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/fast_fists": {
   "v": "Punches do more damage the faster your fists are moving, so try running, jumping, and spinning like crazy.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/floss": "Always remember to floss.",
  "strings/tips/fuse_colors": {
   "v": "You can judge when a bomb is going to explode based on the color of sparks from its fuse: yellow..orange..red..BOOM.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/hockey_turn_gradually": "In hockey, you'll maintain more speed if you turn gradually.",
  "strings/tips/hold_to_run": "Hold any button to run. (Trigger buttons work well if you have them)",
  "strings/tips/ice_bombs": {
   "v": "Ice bombs are not very powerful, but they freeze whoever they hit, leaving them vulnerable to shattering.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/join_leave_anytime": {
   "v": "Players can join and leave in the middle of most games, and you can also plug and unplug game controllers on the fly.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/jump_before_throw": "Jumping just before throwing a bomb will make it go higher.",
  "strings/tips/jump_throw_high": "Jump just as you're throwing to get bombs up to the highest levels.",
  "strings/tips/keep_moving": "If you stay in one place, you're toast. Run and dodge to survive.",
  "strings/tips/land_mines_speedy": "Land-mines are a good way to stop speedy enemies.",
  "strings/tips/momentum_accuracy": "Practice using your momentum to throw bombs more accurately.",
  "strings/tips/one_hit_double_points": "If you kill an enemy in one hit, you get double points.",
  "strings/tips/pickup_flag": "Use the pick-up button to grab the flag < {pickup} >.",
  "strings/tips/play_with_friends": "It's easier to win with a friend or two helping.",
  "strings/tips/punch_to_escape": {
   "v": "If someone picks you up, punch them and they'll let go. This works in real life too.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/reduce_visuals_framerate": {
   "v": "If your framerate is choppy, try turning down resolution or visuals in the game's graphics settings.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/reduce_visuals_heat": {
   "v": "If your device gets too warm or you'd like to conserve battery power, turn down \"Visuals\" or \"Resolution\" in Settings->Graphics.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/remote_app": {
   "v": "If you are short on game controllers, install the '{remote_app_name}' app on your mobile devices to use them as game controllers.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/run_watch_cliffs": {
   "v": "Hold down any button to run. You'll get places faster but won't turn very well, so watch out for cliffs.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/running_spinning_damage": "Your punches do much more damage if you are running or spinning.",
  "strings/tips/shield_overconfidence": "Don't get too cocky with that energy shield; you can still get yourself thrown off a cliff.",
  "strings/tips/spin_punch_respect": {
   "v": "A perfectly timed running-jumping-spin-punch can kill in a single hit and earn you lifelong respect from your friends.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/sticky_bomb_dance": {
   "v": "If you get a sticky bomb stuck to you, jump around and spin in circles. You might shake the bomb off, or if nothing else, your last moments will be entertaining.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/sticky_to_head": {
   "v": "The head is the most vulnerable area, so a sticky-bomb to the noggin usually means game-over.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/throw_players": {
   "v": "Many things can be picked up and thrown, including other players. Tossing your enemies off cliffs can be an effective and emotionally fulfilling strategy.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/throw_strength_direction": {
   "v": "Throw strength depends on the direction you hold. To toss something gently in front of you, don't hold any direction.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/tnt_box": {
   "v": "Take out a group of enemies by setting off a bomb near a TNT box.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/trick_enemies": "Try tricking enemies into killing each other or running off cliffs.",
  "strings/tips/whack_head": {
   "v": "You take damage when you whack your head on things, so try not to whack your head on things.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
  "strings/tips/whip_for_distance": "Whip back and forth to get more distance on your throws.",
  "strings/tips/whiplash_throw": {
   "v": "Run back and forth before throwing a bomb to 'whiplash' it and throw it farther.",
   "w": {
    "mn": 2,
    "mx": 2
   }
  },
